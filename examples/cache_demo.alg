auto a[64]; // начинается с 0x88
auto b[4]; // на 256 байт дальше, поэтому b[0] и a[0] делят одну строку кеша

a[0] = 1; // промах, строка 0x80..0x8F грузится и становится грязной
a[1] = a[0] + 1; // попадания в ту же строку
b[0] = a[1]; // промах с вытеснением грязной строки, 20 тактов
out('0' + a[0] + b[0]); // a[0] снова вытесняет грязную строку
out('\n');
